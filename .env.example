# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# RDS PostgreSQL (use either DATABASE_URL or PG_* below)
# DATABASE_URL=postgresql://user:pass@host:5432/postgres

PG_HOST=your-rds-host.amazonaws.com
PG_USER=dbmasteruser
PG_PASSWORD=your-password
PG_PORT=5432
PG_DATABASE=postgres

# Existing dev schema on RDS — this app NEVER writes here
PG_SCHEMA=GHRIAPP

# Isolated schema for the mock application (created automatically on migrate)
PG_MOCK_SCHEMA=ghri_mock

# Auth / crypto (32+ chars required in production)
SESSION_SECRET=dev-only-insecure-secret-do-not-use-in-production

# Comma-separated browser origins (required in production)
# ALLOWED_ORIGINS=http://localhost:3000

# Frontend URL (Stripe checkout success/cancel redirects)
FRONTEND_URL=http://localhost:3000

# Stripe (required for donations)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email — required for telehealth sign-in codes (pick one option)

# Option A: Resend (recommended — https://resend.com/api-keys)
# RESEND_API_KEY=re_...
# EMAIL_FROM=GHRI Telehealth <onboarding@resend.dev>

# Option B: Gmail / SMTP (use a Google App Password for info.ghrif@gmail.com)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=info.ghrif@gmail.com
# SMTP_PASSWORD=your-google-app-password
# EMAIL_FROM=GHRI Telehealth <info.ghrif@gmail.com>
